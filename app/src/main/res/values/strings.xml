    <!-- Guide screen -->
    <string name="guide_title">指南</string>
    <string name="guide_safety_title">安全须知</string>
    <string name="guide_safety_1">刷写分区属于高风险操作，可能导致设备变砖、数据丢失或无法开机。</string>
    <string name="guide_safety_2">只能刷入来源于可信渠道、与本机型号和分区完全匹配的镜像。</string>
    <string name="guide_safety_3">开始前请先备份当前分区，本应用默认对 boot 系列分区开启备份。</string>
    <string name="guide_safety_4">刷写过程中请勿断电、让设备电量耗尽、强制重启或撤销 Root 授权。</string>
    <string name="guide_safety_5">保持 fastboot 与电脑可用，以便在异常时恢复设备。</string>
    <string name="guide_workflow_title">推荐操作流程</string>
    <string name="guide_workflow_1">获取并允许 Root 权限（Magisk / KernelSU / APatch）。</string>
    <string name="guide_workflow_2">确认设备型号与当前槽位，A/B 设备请选择活动槽位对应的分区。</string>
    <string name="guide_workflow_3">选择目标分区，再选择要刷入的 IMG 文件。</string>
    <string name="guide_workflow_4">等待镜像复制与 SHA-256 计算完成，仔细阅读校验结果。</string>
    <string name="guide_workflow_5">在确认框中核对分区、镜像与 SHA-256，勾选风险确认后刷入。</string>
    <string name="guide_workflow_6">刷写完成后重启设备验证；若失败，按提示恢复备份或使用 fastboot 刷写官方镜像。</string>
    <string name="guide_root_title">Root 管理器说明</string>
    <string name="guide_root_magisk_title">Magisk</string>
    <string name="guide_root_magisk_body">在 Magisk App 的「超级用户」页面允许 PartFlasher；部分版本需要重新打开应用才会再次弹出授权。</string>
    <string name="guide_root_kernelsu_title">KernelSU</string>
    <string name="guide_root_kernelsu_body">在 KernelSU Manager 的「超级用户」列表中授予 PartFlasher 权限；内核模式需要内核已集成 KernelSU。</string>
    <string name="guide_root_apatch_title">APatch</string>
    <string name="guide_root_apatch_body">在 APatch Manager 中授予 PartFlasher 超级用户权限，并确认超级用户开关已启用。</string>
    <string name="guide_root_common_title">通用提示</string>
    <string name="guide_root_common_body">若没有弹出授权窗口，请检查管理器是否开启超级用户功能、是否处于工作资料（分身）空间，或重启管理器后再次检测。</string>
    <string name="guide_formats_title">支持的镜像格式</string>
    <string name="guide_formats_supported_title">支持（v1）</string>
    <string name="guide_formats_supported_body">raw boot / init_boot / vendor_boot / recovery / dtbo / vbmeta / ext4 / erofs 镜像（未压缩、非 sparse）。</string>
    <string name="guide_formats_unsupported_title">暂不支持</string>
    <string name="guide_formats_unsupported_body">Android sparse、gzip / lz4 / zstd 压缩镜像、payload.bin 包。请先解压或转换为 raw 镜像后再刷入。</string>
    <string name="guide_format_limit_note">镜像大小不能超过目标分区容量；boot 系列镜像会校验文件头与分区类型是否匹配。</string>
    <string name="guide_faq_title">常见问题</string>
    <string name="guide_faq_denied_q">授权弹窗点了拒绝 / 没有弹窗？</string>
    <string name="guide_faq_denied_a">打开 Root 管理器，在超级用户列表中找到 PartFlasher 并允许，然后回到应用点击「重新检测」。仍无弹窗时，请确认管理器的超级用户功能已开启。</string>
    <string name="guide_faq_nopartition_q">看不到分区 / 分区列表为空？</string>
    <string name="guide_faq_nopartition_a">分区列表需要 Root 权限才能读取。请先确认已授权，再点击刷新；若读取失败可查看日志中的 su 输出。</string>
    <string name="guide_faq_verify_q">校验不匹配怎么办？</string>
    <string name="guide_faq_verify_a">请勿反复写入。检查镜像是否损坏、分区容量是否足够、存储是否稳定；如有备份，可按备份路径恢复，或使用 fastboot 刷写官方镜像。</string>
    <string name="guide_faq_brick_q">刷入后无法开机怎么办？</string>
    <string name="guide_faq_brick_a">保持冷静，不要反复刷写。可尝试进入 fastboot 或恢复模式，用电脑刷写官方完整包；如刷写前已备份，可在 /data/local/tmp 下找到备份文件恢复。</string>
    <string name="guide_faq_data_q">会清除数据吗？</string>
    <string name="guide_faq_data_a">本应用只写入你选择的分区，不会主动清除 userdata。但错误刷写可能影响系统启动，建议提前备份重要数据。</string>
